@page "/pipelines/nuevo"
@page "/pipelines/editar/{Id:guid}"
@inject PipelinesAdminService Pipelines
@inject DataSourcesAdminService Origenes
@inject NavigationManager Nav

<PageTitle>@(Id is null ? "Nuevo pipeline" : "Editar pipeline") — Admin</PageTitle>

<div class="page-header">
    <div>
        <h1 class="page-title">@(Id is null ? "Nuevo pipeline" : "Editar pipeline")</h1>
    </div>
    <SfButton CssClass="e-flat" OnClick="@(() => Nav.NavigateTo("/pipelines"))">Volver a la lista</SfButton>
</div>

@if (_error is not null)
{
    <SfMessage Severity="MessageSeverity.Error" CssClass="mb-3">@_error</SfMessage>
}

@if (_cargando)
{
    <div style="position:relative;min-height:80px;"><SfSpinner Visible="true" /></div>
}
else
{
    <div class="panel mb-3">
        <div class="pa-4 d-flex gap-3 align-center flex-wrap">
            <div class="flex-grow-1">
                <SfTextBox Placeholder="Nombre *" FloatLabelType="FloatLabelType.Always" @bind-Value="_form.Nombre" />
            </div>
            <SfCheckBox @bind-Checked="_form.Habilitado" Label="Habilitado"></SfCheckBox>
        </div>
    </div>

    <div class="d-flex align-center gap-2 mb-4 flex-wrap">
        <SfButton CssClass="@(_pasoActivo == 1 ? "e-primary e-small" : "e-flat e-small")" Disabled="@(!PasoHabilitado(1))" OnClick="@(() => IrAPaso(1))">1. Origen y columnas</SfButton>
        <span class="texto-secundario">›</span>
        <SfButton CssClass="@(_pasoActivo == 2 ? "e-primary e-small" : "e-flat e-small")" Disabled="@(!PasoHabilitado(2))" OnClick="@(() => IrAPaso(2))">2. Salida</SfButton>
        <span class="texto-secundario">›</span>
        <SfButton CssClass="@(_pasoActivo == 3 ? "e-primary e-small" : "e-flat e-small")" Disabled="@(!PasoHabilitado(3))" OnClick="@(() => IrAPaso(3))">3. Transformaciones</SfButton>
    </div>

    @if (_pasoActivo == 1)
    {
        <div class="panel mb-4">
            <div class="panel-header">Paso 1 — Origen y columnas</div>
            <div class="pa-4">
                <div class="mb-3">
                    <SfDropDownList TValue="Guid?" TItem="DataSourceVista" DataSource="_datasources" @bind-Value="_form.DataSourceId"
                                    Placeholder="DataSource *" FloatLabelType="FloatLabelType.Always">
                        <DropDownListFieldSettings Value="Id" Text="Nombre"></DropDownListFieldSettings>
                    </SfDropDownList>
                </div>
                @* Fecha: 03/09/2026 - TAREA: 00015 - Linea: 1 - Origenes de archivo (Csv/Xlsx): Paso 1 reacciona al Tipo del origen elegido. *@
                @* Fecha: 31/10/2026 - TAREA: 00154 - Linea: 2 - Tercera rama: DataHub. El endpoint se
                   elige de un combo que sale del catalogo, y los parametros los declara el propio
                   endpoint, asi que no se escriben a mano: solo se cargan sus valores. *@
                @if (EsOrigenDataHub)
                {
                    <div class="mb-3 d-flex align-center gap-2">
                        <SfButton CssClass="e-small" OnClick="TraerCatalogo" Disabled="_catalogoCargando">
                            @(_catalogoCargando ? "Trayendo el catalogo..." : "Traer endpoints")
                        </SfButton>
                        @if (_endpoints.Count > 0)
                        {
                            <span class="texto-caption texto-secundario">@_endpoints.Count endpoint(s) para elegir.</span>
                        }
                    </div>

                    @if (_catalogoError is not null)
                    {
                        <SfMessage Severity="MessageSeverity.Error" CssClass="mb-3">
                            <b>No se pudo traer el catalogo.</b><br />@_catalogoError
                        </SfMessage>
                        @* Fecha: 31/10/2026 - TAREA: 00154 - Linea: 2 - Revision 1, hallazgo P1: el modo
                           manual dejaba escribir la ruta pero no el metodo ni los parametros, asi que
                           guardaba GET y la lista vacia. Un endpoint POST o con parametros obligatorios
                           quedaba roto desde el alta, y recien fallaba al correr. *@
                        <div class="mb-3">
                            <SfTextBox Placeholder="Ruta del endpoint (a mano)" FloatLabelType="FloatLabelType.Always"
                                       @bind-Value="_form.Ruta" />
                        </div>
                        <div class="mb-3" style="max-width:220px;">
                            <SfDropDownList TValue="string" TItem="string" DataSource="_metodosHttp"
                                            @bind-Value="_form.MetodoHttp" Placeholder="Metodo *"
                                            FloatLabelType="FloatLabelType.Always" />
                        </div>
                        <div class="texto-caption texto-secundario mb-2" style="font-weight:700;letter-spacing:.04em;">
                            PARAMETROS (A MANO)
                        </div>
                        <div class="texto-caption texto-secundario mb-2">
                            Tienen que ser <b>exactamente</b> los que declara el endpoint en DataHub: uno de mas
                            hace fallar la consulta. Si el endpoint usa carga incremental, agrega <code>watermark</code>
                            y dejalo vacio.
                        </div>
                        @foreach (var par in _form.Parametros)
                        {
                            <div class="d-flex align-center gap-2 mb-2">
                                <div style="width:200px;">
                                    <SfTextBox Placeholder="Nombre" FloatLabelType="FloatLabelType.Never"
                                               @bind-Value="par.Clave" />
                                </div>
                                <div class="flex-grow-1">
                                    <SfTextBox Placeholder="Valor" FloatLabelType="FloatLabelType.Never"
                                               @bind-Value="par.Valor" />
                                </div>
                                <SfButton CssClass="e-flat e-small" OnClick="@(() => _form.Parametros.Remove(par))">
                                    Quitar
                                </SfButton>
                            </div>
                        }
                        <div class="mb-3">
                            <SfButton CssClass="e-flat e-small" OnClick="@(() => _form.Parametros.Add(new KV()))">
                                + Agregar parametro
                            </SfButton>
                        </div>
                    }
                    else if (_endpoints.Count == 0 && !_catalogoCargando)
                    {
                        @* Fecha: 31/10/2026 - TAREA: 00154 - Linea: 4 - Al editar un pipeline ya guardado
                           el catalogo todavia no se pidio, asi que sin esto la pantalla no mostraba QUE
                           endpoint tiene configurado: habia que apretar "Traer endpoints" para enterarse,
                           y si DataHub estaba caido no se enteraba nunca. *@
                        @if (!string.IsNullOrWhiteSpace(_form.Ruta))
                        {
                            <div class="mb-3">
                                <span class="flabel-suelta">Endpoint configurado</span>
                                <div class="finput-suelto">@_form.Ruta</div>
                                <div class="texto-caption texto-secundario mt-1">
                                    Toca "Traer endpoints" para cambiarlo o para ver sus parametros.
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="texto-caption texto-secundario mb-3">
                                Toca "Traer endpoints" para ver los que DataHub tiene publicados. Si la lista
                                vuelve vacia, hay que asignarle los endpoints en DataHub a la credencial de datos.
                            </div>
                        }
                    }
                    else if (_endpoints.Count > 0)
                    {
                        <div class="mb-3">
                            @* Fecha: 31/10/2026 - TAREA: 00154 - Linea: 2 - Revision 1, hallazgo P1: el
                               combo se enlaza a la clave (metodo + ruta), no a la ruta sola. Con la
                               misma ruta publicada como GET y como POST, elegir por ruta era ambiguo. *@
                            <SfDropDownList TValue="string" TItem="EndpointDataHubDto" DataSource="_endpoints"
                                            @bind-Value="_form.ClaveEndpoint" Placeholder="Endpoint *"
                                            FloatLabelType="FloatLabelType.Always" AllowFiltering="true">
                                <DropDownListFieldSettings Value="Clave" Text="Clave"></DropDownListFieldSettings>
                                <DropDownListEvents TValue="string" TItem="EndpointDataHubDto" ValueChange="@((Syncfusion.Blazor.DropDowns.ChangeEventArgs<string, EndpointDataHubDto> _) => EndpointCambio())"></DropDownListEvents>
                            </SfDropDownList>
                        </div>

                        @if (EndpointElegido is not null)
                        {
                            <div class="d-flex flex-wrap gap-2 mb-3 align-center">
                                <span class="chip-metodo">@EndpointElegido.MetodoHttp</span>
                                <span class="texto-caption texto-secundario">@EndpointElegido.Motor</span>
                                @if (!string.IsNullOrWhiteSpace(EndpointElegido.Descripcion))
                                {
                                    <span class="texto-caption texto-secundario">— @EndpointElegido.Descripcion</span>
                                }
                            </div>

                            @if (_form.Parametros.Count > 0)
                            {
                                <div class="texto-caption texto-secundario mb-2" style="font-weight:700;letter-spacing:.04em;">
                                    PARAMETROS DEL ENDPOINT
                                </div>
                                @foreach (var par in _form.Parametros)
                                {
                                    var decl = EndpointElegido.Parametros.FirstOrDefault(x => x.Nombre == par.Clave);
                                    <div class="d-flex align-center gap-2 mb-2">
                                        <div style="width:140px;font-size:.82rem;font-weight:600;">@par.Clave</div>
                                        <div style="width:90px;" class="texto-caption texto-secundario">@(decl?.Tipo ?? "texto")</div>
                                        @if (EsWatermark(par.Clave))
                                        {
                                            @* El watermark lo completa la corrida: cargarlo a mano congelaria la carga incremental. *@
                                            <span class="texto-caption texto-secundario">
                                                lo completa la corrida — vacio en la primera
                                            </span>
                                        }
                                        else
                                        {
                                            <div class="flex-grow-1">
                                                <SfTextBox Placeholder="@(decl?.Etiqueta ?? par.Clave)"
                                                           FloatLabelType="FloatLabelType.Never"
                                                           @bind-Value="par.Valor" />
                                            </div>
                                        }
                                    </div>
                                }
                            }
                        }
                    }
                }
                else if (EsOrigenSql)
                {
                    <div class="mb-1">
                        <SfTextBox Placeholder="SQL *" FloatLabelType="FloatLabelType.Always" Multiline="true" @bind-Value="_form.Sql" />
                    </div>
                }
                else
                {
                    <div class="texto-caption texto-secundario mb-1">
                        Origen de archivo: no hace falta SQL. "Traer columnas" lee el encabezado del archivo mas nuevo sin procesar.
                    </div>
                }
                <div class="mt-2 mb-3 d-flex align-center gap-2">
                    @* Fecha: 31/10/2026 - TAREA: 00154 - Linea: 3 - Para DataHub lo que hace falta es
                       el endpoint, no el SQL. *@
                    <SfButton CssClass="e-small" OnClick="@(() => TraerColumnas())"
                              Disabled="@(_form.DataSourceId is null
                                          || (EsOrigenSql && string.IsNullOrWhiteSpace(_form.Sql))
                                          || (EsOrigenDataHub && string.IsNullOrWhiteSpace(_form.Ruta)))">
                        Traer columnas
                    </SfButton>
                    @if (_columnasMsg is not null)
                    {
                        <span class="texto-caption texto-secundario">@_columnasMsg</span>
                    }
                </div>

                @* Fecha: 31/10/2026 - TAREA: 00154 - Linea: 3 - Fallback de la decision D3: el endpoint
                   nunca paso una prueba en DataHub, asi que no hay esquema guardado que leer. Ejecutar
                   corre la consulta de verdad contra la base de ellos: por eso es un boton aparte y no
                   algo que pase solo. *@
                @if (_faltaEsquema)
                {
                    <div class="mb-3">
                        <SfButton CssClass="e-small e-outline" OnClick="@(() => TraerColumnas(true))">
                            Ejecutar la consulta para descubrir las columnas
                        </SfButton>
                        <div class="texto-caption texto-secundario mt-1">
                            Corre el endpoint de verdad, con los parametros cargados. Lo barato es probarlo
                            una vez en DataHub: ahi queda guardado y sirve para todos los pipelines.
                        </div>
                    </div>
                }
                @if (_form.EsquemaOrigen.Count > 0)
                {
                    <div class="d-flex flex-wrap gap-2 mb-3">
                        @foreach (var c in _form.EsquemaOrigen)
                        {
                            <span style="border:1px solid #d0d0d0;border-radius:6px;padding:2px 8px;font-size:12px;">@c.Nombre <span class="texto-secundario">@c.Tipo</span></span>
                        }
                    </div>
                    <div class="mb-1">
                        <SfDropDownList TValue="string" TItem="string" DataSource="NombresColumnas" @bind-Value="_form.ColumnaWatermark"
                                        Placeholder="Columna watermark (opcional)" FloatLabelType="FloatLabelType.Always" AllowFiltering="true" />
                        @if (EsOrigenSql)
                        {
                            <div class="texto-caption texto-secundario mt-1">
                                Tu SQL debe filtrar con @@watermark (ej. WHERE @@watermark IS NULL OR fecha_mod &gt; @@watermark).
                                Si la columna es fecha, debe ser datetime/datetime2.
                            </div>
                        }
                        @* Fecha: 31/10/2026 - TAREA: 00154 - Linea: 4 - Reglas R1 y R2: se cumplen en el
                           SQL del endpoint, del lado de DataHub, no aca. Van en pantalla porque son
                           justo las dos que se olvidan y cuestan una tarde de depuracion. *@
                        @if (EsOrigenDataHub)
                        {
                            <div class="texto-caption texto-secundario mt-1">
                                El SQL del endpoint, <b>en DataHub</b>, tiene que tratar el watermark vacio como
                                primera corrida — vacio no es NULL:<br />
                                <code>WHERE :watermark IS NULL OR :watermark = '' OR fecha_mod &gt; ...</code><br />
                                Y como a Oracle los parametros llegan como texto, la comparacion necesita
                                conversion explicita:<br />
                                <code>AND fecha_mod &gt; TO_DATE(:watermark, 'YYYY-MM-DD HH24:MI:SS')</code>
                            </div>
                        }
                    </div>
                    @if (EsOrigenDeArchivo && !string.IsNullOrWhiteSpace(_form.ColumnaWatermark))
                    {
                        <div class="mb-1">
                            <SfDropDownList TValue="string" TItem="string" DataSource="_tiposCast" @bind-Value="_form.ColumnaWatermarkTipo"
                                            Placeholder="Tipo de columna watermark" FloatLabelType="FloatLabelType.Always" />
                            <div class="texto-caption texto-secundario mt-1">
                                Necesario para comparar bien un archivo (texto plano): sin esto, una fecha o un numero se compara como texto.
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    }

    @if (_pasoActivo == 2)
    {
        <div class="panel mb-4">
            <div class="panel-header">Paso 2 — Salida</div>
            <div class="pa-4">
                @if (_form.EsquemaOrigen.Count > 0)
                {
                    <div class="texto-caption texto-secundario mb-1">Columnas del origen</div>
                    <div class="d-flex flex-wrap gap-2 mb-3">
                        @foreach (var n in NombresColumnas)
                        {
                            <span style="border:1px solid #d0d0d0;border-radius:6px;padding:2px 8px;font-size:12px;">@n</span>
                        }
                    </div>
                }
                <div class="mb-3">
                    <SfMultiSelect TValue="List<string>" TItem="string" DataSource="NombresColumnas" @bind-Value="_form.ColumnasClave"
                                   Placeholder="Columnas clave (requerido si Reemplazar)" FloatLabelType="FloatLabelType.Always" AllowCustomValue="true" />
                </div>
                <div class="d-flex gap-3">
                    <div class="flex-grow-1 mb-3">
                        <SfDropDownList TValue="int" TItem="Opcion" DataSource="_modos" @bind-Value="_form.ModoEscritura"
                                        Placeholder="Modo de escritura" FloatLabelType="FloatLabelType.Always">
                            <DropDownListFieldSettings Value="Valor" Text="Texto"></DropDownListFieldSettings>
                        </SfDropDownList>
                    </div>
                    <div class="flex-grow-1 mb-3">
                        <SfTextBox Placeholder="Tabla destino *" FloatLabelType="FloatLabelType.Always" @bind-Value="_form.TablaDestino" />
                    </div>
                </div>
                <div class="mb-1" style="max-width:220px;">
                    <label class="texto-caption texto-secundario">Filas por lote</label>
                    <SfNumericTextBox TValue="int" @bind-Value="_form.FilasPorLote" Min="1"></SfNumericTextBox>
                </div>
            </div>
        </div>
    }

    @if (_pasoActivo == 3)
    {
        <div class="panel mb-4">
            <div class="panel-header d-flex justify-space-between align-center">
                <span>Paso 3 — Transformaciones (opcional)</span>
                <SfButton CssClass="e-small" OnClick="AgregarTransform">+ Agregar transformacion</SfButton>
            </div>
            <div class="pa-4">
                @if (_form.Transforms.Count == 0)
                {
                    <div class="texto-secundario">Sin transformaciones. El origen se escribe tal cual en la tabla destino.</div>
                }
                @for (var i = 0; i < _form.Transforms.Count; i++)
                {
                    var t = _form.Transforms[i];
                    var idx = i;
                    <div class="panel pa-3 mb-3">
                        <div class="d-flex justify-space-between align-center mb-1">
                            <strong>Bloque de transformacion @(idx + 1)</strong>
                            <span class="d-flex gap-1">
                                <SfButton CssClass="e-small" Disabled="@(idx == 0)" OnClick="@(() => Subir(t))">▲</SfButton>
                                <SfButton CssClass="e-small" Disabled="@(idx == _form.Transforms.Count - 1)" OnClick="@(() => Bajar(t))">▼</SfButton>
                                <SfButton CssClass="e-small e-danger e-outline" OnClick="@(() => QuitarTransform(t))">Quitar</SfButton>
                            </span>
                        </div>
                        <div class="texto-caption texto-secundario mb-3">Orden: renombrar → convertir tipo → calcular → filtrar</div>
                        <div class="mb-3">
                            <SfTextBox Placeholder="Nombre del bloque" FloatLabelType="FloatLabelType.Always" @bind-Value="t.Nombre" />
                        </div>
                        <KeyValueEditor Items="t.Rename" Titulo="Renombrar columnas" Descripcion="Cambia el nombre de una columna."
                                        ClaveLabel="Columna" ValorLabel="Nuevo nombre" ClaveOpciones="NombresColumnas" />
                        <KeyValueEditor Items="t.Cast" Titulo="Convertir tipo" Descripcion="Convierte el valor de una columna al tipo elegido."
                                        ClaveLabel="Columna" ValorLabel="Tipo" ClaveOpciones="NombresColumnas" ValorOpciones="_tiposCast" />
                        <KeyValueEditor Items="t.Computed" Titulo="Columna calculada" Descripcion="Crea una columna nueva con una expresion (ej. precio * 1.21)."
                                        ClaveLabel="Nueva columna" ValorLabel="Expresion" />
                        <div class="mb-2">
                            <label class="texto-body2" style="font-weight:600;">Filtrar filas</label>
                            <div class="texto-caption texto-secundario mb-1">Solo pasan las filas donde la expresion es verdadera (ej. monto &gt; 0).</div>
                            <SfTextBox Placeholder="Expresion booleana (opcional)" @bind-Value="t.Filter" />
                        </div>
                        <div class="pa-2 mb-1" style="border:0.5px solid #d0d0d0;border-radius:6px;">
                            <div class="texto-caption texto-secundario">
                                <strong>Sintaxis (NCalc):</strong>
                                operadores <code>+ - * / &gt; &lt; == != and or not</code> ·
                                condicional <code>if(cond, a, b)</code> ·
                                funciones <code>Round, Abs, Max, Min, Floor, Ceiling</code>.
                                <a href="https://github.com/ncalc/ncalc/wiki/Functions" target="_blank" rel="noopener">Ver funciones</a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="panel mb-4">
            <div class="panel-header">Programacion</div>
            <div class="pa-4">
                <div class="d-flex gap-3 flex-wrap">
                    <div class="flex-grow-1 mb-3">
                        <SfDropDownList TValue="int" TItem="Opcion" DataSource="_programaciones" @bind-Value="_form.Programacion"
                                        Placeholder="Programacion" FloatLabelType="FloatLabelType.Always">
                            <DropDownListFieldSettings Value="Valor" Text="Texto"></DropDownListFieldSettings>
                        </SfDropDownList>
                    </div>
                    @if (_form.Programacion != 0)
                    {
                        <div class="flex-grow-1 mb-3">
                            <SfTextBox Placeholder="Hora del dia (HH:mm)" FloatLabelType="FloatLabelType.Always" @bind-Value="_form.HoraDelDia" />
                        </div>
                    }
                    @if (_form.Programacion == 2)
                    {
                        <div class="flex-grow-1 mb-3">
                            <SfDropDownList TValue="int" TItem="Opcion" DataSource="_diasSemana" @bind-Value="_form.DiaDeLaSemana"
                                            Placeholder="Dia de la semana" FloatLabelType="FloatLabelType.Always">
                                <DropDownListFieldSettings Value="Valor" Text="Texto"></DropDownListFieldSettings>
                            </SfDropDownList>
                        </div>
                    }
                    @if (_form.Programacion == 3)
                    {
                        <div class="flex-grow-1 mb-3">
                            <label class="texto-caption texto-secundario">Dia del mes (1-28)</label>
                            <SfNumericTextBox TValue="int" @bind-Value="_form.DiaDelMes" Min="1" Max="28"></SfNumericTextBox>
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    <div class="d-flex gap-2 mb-8 align-center">
        <SfButton CssClass="e-flat" OnClick="Atras" Disabled="@(_pasoActivo == 1)">← Atras</SfButton>
        @if (_pasoActivo < 3)
        {
            <SfButton CssClass="e-primary" OnClick="Siguiente" Disabled="@(!PuedeAvanzar)">Siguiente →</SfButton>
            @if (_pasoActivo == 1 && !PuedeAvanzar)
            {
                <span class="texto-caption texto-secundario">Trae las columnas para continuar.</span>
            }
        }
        else
        {
            <SfButton CssClass="e-primary" OnClick="Guardar" Disabled="_guardando">
                @(_guardando ? "Guardando..." : "Guardar")
            </SfButton>
        }
        <SfButton CssClass="e-flat" OnClick="@(() => Nav.NavigateTo("/pipelines"))">Cancelar</SfButton>
    </div>
}

@code {
    [Parameter] public Guid? Id { get; set; }

    private sealed record Opcion(int Valor, string Texto);

    private sealed class PipelineForm
    {
        public Guid Id { get; set; }
        public string Nombre { get; set; } = "";
        public bool Habilitado { get; set; } = true;
        public string TablaDestino { get; set; } = "";
        public int ModoEscritura { get; set; } = 2; // Reemplazar
        public List<string> ColumnasClave { get; set; } = new();
        public string? ColumnaWatermark { get; set; } = ""; // columna del origen a trackear; vacio = no incremental
        // Fecha: 03/09/2026 - TAREA: 00015 - Linea: 1 - Solo aplica a origenes Csv/Xlsx (SqlServer ya viene tipado).
        public string? ColumnaWatermarkTipo { get; set; } = "";
        public List<ColumnaOrigenDto> EsquemaOrigen { get; set; } = new();
        public int Programacion { get; set; }        // 0 = BajoDemanda
        public string? HoraDelDia { get; set; } = "08:00";
        public int DiaDeLaSemana { get; set; } = 1;
        public int DiaDelMes { get; set; } = 1;
        public int FilasPorLote { get; set; } = 5000;
        public Guid? DataSourceId { get; set; }
        public string Sql { get; set; } = "";
        // Fecha: 31/10/2026 - TAREA: 00154 - Linea: 4 - Origen DataHub: endpoint elegido y los valores
        // de los parametros que ese endpoint declara.
        public string Ruta { get; set; } = "";
        // Fecha: 31/10/2026 - TAREA: 00154 - Linea: 4 - Revision 1, hallazgo P1: el metodo y el esquema
        // se guardaban SOLO si el catalogo estaba cargado. Editar un pipeline POST sin tocar el origen
        // lo convertia en GET y le borraba el esquema, en silencio. Ahora el formulario los recuerda.
        public string MetodoHttp { get; set; } = "";
        /// <summary>Lo que elige el combo: "METODO ruta". Ruta y metodo se derivan de aca.</summary>
        public string ClaveEndpoint { get; set; } = "";
        public string? EsquemaJson { get; set; }
        public List<KV> Parametros { get; set; } = new();
        public List<TransformForm> Transforms { get; set; } = new();
    }

    private sealed class TransformForm
    {
        public string Nombre { get; set; } = "transform";
        public List<KV> Rename { get; set; } = new();
        public List<KV> Cast { get; set; } = new();
        public List<KV> Computed { get; set; } = new();
        public string? Filter { get; set; }
    }

    private readonly List<Opcion> _modos = new() { new(0, "Agregar"), new(2, "Reemplazar") };
    private readonly List<Opcion> _programaciones = new()
    {
        new(0, "Bajo demanda"), new(1, "Diaria"), new(2, "Semanal"), new(3, "Mensual")
    };
    private readonly List<Opcion> _diasSemana = new()
    {
        new(0, "Domingo"), new(1, "Lunes"), new(2, "Martes"), new(3, "Miercoles"),
        new(4, "Jueves"), new(5, "Viernes"), new(6, "Sabado")
    };
    private readonly List<string> _tiposCast = new() { "int", "long", "decimal", "double", "bool", "date", "string" };
    // Fecha: 31/10/2026 - TAREA: 00154 - Linea: 2 - Los dos metodos que expone /api/query de DataHub.
    private readonly List<string> _metodosHttp = new() { "GET", "POST" };

    private List<DataSourceVista> _datasources = new();
    private PipelineForm _form = new();
    private bool _cargando = true;
    private bool _guardando;
    private string? _error;
    private string? _columnasMsg;

    // Fecha: 31/10/2026 - TAREA: 00154 - Linea: 2 - Estado del catalogo de endpoints de DataHub.
    private List<EndpointDataHubDto> _endpoints = new();
    private bool _catalogoCargando;
    private string? _catalogoError;
    private bool _faltaEsquema;

    private int _pasoActivo = 1;

    private bool Editando => Id is not null;

    // Gates: P1 requiere columnas traidas; P2 requiere destino + (si Reemplazar) al menos una clave.
    private bool GateP1 => _form.EsquemaOrigen.Count > 0;
    private bool GateP2 => !string.IsNullOrWhiteSpace(_form.TablaDestino)
        && (_form.ModoEscritura != 2 || _form.ColumnasClave.Count > 0);

    // En modo edicion todos los pasos son navegables (el pipeline ya es valido).
    private bool PasoHabilitado(int n) => Editando || n switch
    {
        1 => true,
        2 => GateP1,
        3 => GateP1 && GateP2,
        _ => false
    };

    private bool PuedeAvanzar => Editando || _pasoActivo switch { 1 => GateP1, 2 => GateP2, _ => true };

    private void IrAPaso(int n) { if (PasoHabilitado(n)) _pasoActivo = n; }
    private void Atras() { if (_pasoActivo > 1) _pasoActivo--; }
    private void Siguiente() { if (_pasoActivo < 3 && PuedeAvanzar) _pasoActivo++; }

    protected override async Task OnInitializedAsync()
    {
        _datasources = await Origenes.ObtenerTodosAsync();

        if (Id is Guid id)
        {
            var def = await Pipelines.ObtenerPorIdAsync(id);
            if (def is null) { _error = "No se encontro el pipeline."; }
            else { Cargar(def); }
        }
        _cargando = false;
    }

    private void AgregarTransform() =>
        _form.Transforms.Add(new TransformForm { Nombre = $"transform{_form.Transforms.Count + 1}" });

    private void QuitarTransform(TransformForm t) => _form.Transforms.Remove(t);

    // Fecha: 03/09/2026 - TAREA: 00015 - Linea: 1 - Origenes de archivo: sin SQL, se lee el encabezado de la carpeta.
    // Fecha: 31/10/2026 - TAREA: 00154 - Linea: 3 - DataHub: las columnas salen del esquema que DataHub
    // ya guardo, sin ejecutar nada. Y el error real deja de perderse: antes cualquier fallo se mostraba
    // con el mismo texto generico sobre el SQL o la carpeta, que para DataHub no queria decir nada.
    private async Task TraerColumnas(bool ejecutar = false)
    {
        _columnasMsg = ejecutar ? "Ejecutando la consulta..." : "Trayendo...";
        _faltaEsquema = false;

        var r = await Origenes.TraerColumnasAsync(
            _form.DataSourceId!.Value,
            EsOrigenSql ? _form.Sql : null,
            EsOrigenDataHub ? _form.Ruta : null,
            EsOrigenDataHub ? ValoresDeParametros() : null,
            ejecutar,
            EsOrigenDataHub ? _form.MetodoHttp : null);

        if (!r.Ok)
        {
            _columnasMsg = r.Error ?? "No se pudieron traer las columnas.";
            // Si el endpoint nunca paso una prueba en DataHub no hay esquema guardado: ahi se ofrece
            // el ultimo recurso de ejecutar la consulta, que es lo unico que queda.
            _faltaEsquema = EsOrigenDataHub && !ejecutar
                && (r.Error?.Contains("esquema guardado", StringComparison.OrdinalIgnoreCase) ?? false);
            return;
        }

        _form.EsquemaOrigen = r.Columnas;
        _columnasMsg = EsOrigenDataHub && !ejecutar
            ? $"{r.Columnas.Count} columnas, del esquema guardado en DataHub. No se ejecuto la consulta."
            : $"{r.Columnas.Count} columnas.";
    }

    // Fecha: 31/10/2026 - TAREA: 00154 - Linea: 2 - Catalogo de endpoints de DataHub.
    private async Task TraerCatalogo()
    {
        if (_form.DataSourceId is null || !EsOrigenDataHub) return;

        _catalogoCargando = true;
        _catalogoError = null;
        try
        {
            var r = await Origenes.ObtenerEndpointsAsync(_form.DataSourceId.Value);
            if (!r.Ok)
            {
                _endpoints = new();
                _catalogoError = r.Error;
                return;
            }
            _endpoints = r.Endpoints;

            // Al traer el catalogo sobre un pipeline ya guardado hay que reconstruir la clave del
            // combo desde la ruta y el metodo que tenia, o el endpoint elegido se perderia.
            if (string.IsNullOrWhiteSpace(_form.ClaveEndpoint) && !string.IsNullOrWhiteSpace(_form.Ruta))
            {
                var guardado = _endpoints.FirstOrDefault(e =>
                    e.Ruta.Equals(_form.Ruta, StringComparison.OrdinalIgnoreCase)
                    && (string.IsNullOrWhiteSpace(_form.MetodoHttp)
                        || e.MetodoHttp.Equals(_form.MetodoHttp, StringComparison.OrdinalIgnoreCase)));
                if (guardado is not null)
                {
                    _form.ClaveEndpoint = guardado.Clave;
                    _form.MetodoHttp = guardado.MetodoHttp;
                    _form.EsquemaJson ??= guardado.EsquemaJson;
                }
            }

            SincronizarParametros();
        }
        finally { _catalogoCargando = false; }
    }

    /// <summary>
    /// Deja una fila por cada parametro que DECLARA el endpoint elegido, conservando los valores ya
    /// cargados. Es lo que hace cumplir la regla R1: el paso guarda exactamente los parametros
    /// declarados, porque uno de mas hace fallar la consulta del lado de DataHub.
    /// </summary>
    private void SincronizarParametros()
    {
        var ep = EndpointElegido;
        if (ep is null) { _form.Parametros.Clear(); return; }

        var previos = _form.Parametros.ToDictionary(x => x.Clave, x => x.Valor, StringComparer.Ordinal);
        _form.Parametros = ep.Parametros
            .Select(p => new KV { Clave = p.Nombre, Valor = previos.GetValueOrDefault(p.Nombre, "") })
            .ToList();
    }

    private Dictionary<string, string> ValoresDeParametros() =>
        _form.Parametros
            .Where(x => !string.IsNullOrWhiteSpace(x.Clave))
            .ToDictionary(x => x.Clave.Trim(), x => x.Valor ?? "", StringComparer.Ordinal);

    // Fecha: 31/10/2026 - TAREA: 00154 - Linea: 2 - Revision 1, hallazgo P1: la identidad es ruta +
    // metodo. Si el catalogo publica la misma ruta como GET y como POST, buscar por ruta sola elige
    // cualquiera de los dos y el paso puede terminar guardado con el metodo del otro.
    private EndpointDataHubDto? EndpointElegido =>
        _endpoints.FirstOrDefault(e => e.Clave == _form.ClaveEndpoint);

    /// <summary>El watermark no se carga a mano: lo completa la corrida (ver la maqueta del Paso 1).</summary>
    private static bool EsWatermark(string nombre) =>
        nombre.Equals("watermark", StringComparison.OrdinalIgnoreCase);

    private void EndpointCambio()
    {
        // La clave (metodo + ruta) es lo que elige el combo; ruta y metodo se derivan de ella.
        var ep = EndpointElegido;
        _form.Ruta = ep?.Ruta ?? "";
        _form.MetodoHttp = ep?.MetodoHttp ?? "";
        _form.EsquemaJson = ep?.EsquemaJson;

        SincronizarParametros();
        _form.EsquemaOrigen = new();
        _form.ColumnaWatermark = "";
        _columnasMsg = null;
        _faltaEsquema = false;
    }

    private List<string> NombresColumnas => _form.EsquemaOrigen.Select(c => c.Nombre).ToList();

    // Fecha: 03/09/2026 - TAREA: 00015 - Linea: 1 - Origen de archivo = no hay SQL; hay tipo de watermark.
    private int? TipoDataSourceElegido =>
        _datasources.FirstOrDefault(d => d.Id == _form.DataSourceId)?.Tipo;

    // Fecha: 31/10/2026 - TAREA: 00154 - Linea: 4 - DataHub CompLook = 3. Antes todo lo que no fuera
    // Csv/Xlsx se trataba como SQL Server, asi que un origen DataHub pedia un SQL que nadie iba a usar.
    private bool EsOrigenDeArchivo => TipoDataSourceElegido is 1 or 2; // Csv=1, Xlsx=2 (ver DataSourcesAdminService)
    private bool EsOrigenDataHub => TipoDataSourceElegido is 3;
    private bool EsOrigenSql => TipoDataSourceElegido is 0 or null;

    private void Subir(TransformForm t)
    {
        var i = _form.Transforms.IndexOf(t);
        if (i > 0) { _form.Transforms.RemoveAt(i); _form.Transforms.Insert(i - 1, t); }
    }

    private void Bajar(TransformForm t)
    {
        var i = _form.Transforms.IndexOf(t);
        if (i >= 0 && i < _form.Transforms.Count - 1) { _form.Transforms.RemoveAt(i); _form.Transforms.Insert(i + 1, t); }
    }

    private async Task Guardar()
    {
        _error = null;
        if (string.IsNullOrWhiteSpace(_form.Nombre)) { _error = "El nombre es obligatorio."; return; }
        if (string.IsNullOrWhiteSpace(_form.TablaDestino)) { _error = "La tabla destino es obligatoria."; return; }
        // Fecha: 03/09/2026 - TAREA: 00015 - Linea: 1 - Origenes de archivo (Csv/Xlsx) no requieren SQL.
        // Fecha: 31/10/2026 - TAREA: 00154 - Linea: 4 - DataHub pide endpoint, no SQL.
        if (_form.DataSourceId is not null && EsOrigenDataHub && string.IsNullOrWhiteSpace(_form.Ruta))
        {
            _error = "Elegi un endpoint de DataHub.";
            return;
        }
        // Revision 1: con la ruta escrita a mano, el metodo no se puede adivinar. DataHub busca por
        // ruta Y metodo: con el equivocado devuelve 404 hablando de un endpoint que no existe.
        if (_form.DataSourceId is not null && EsOrigenDataHub
            && EndpointElegido is null && string.IsNullOrWhiteSpace(_form.MetodoHttp))
        {
            _error = "Falta el metodo del endpoint (GET o POST). DataHub lo busca por ruta y metodo.";
            return;
        }
        if (_form.DataSourceId is null || (EsOrigenSql && string.IsNullOrWhiteSpace(_form.Sql)))
        {
            _error = "El origen requiere un DataSource" + (EsOrigenSql ? " y un SQL." : ".");
            return;
        }
        if (_form.ModoEscritura == 2 && _form.ColumnasClave.Count == 0)
        {
            _error = "Reemplazar requiere al menos una columna clave.";
            return;
        }
        // Fecha: 05/09/2026 - TAREA: 00015 - Linea: 1 - Revision final: elegir columna watermark sin
        // elegir su tipo dejaba FileSourceBase comparando como texto plano ("string" por defecto), el
        // mismo bug de fondo que el diseño de tipado de watermark existe para evitar.
        if (EsOrigenDeArchivo && !string.IsNullOrWhiteSpace(_form.ColumnaWatermark)
            && string.IsNullOrWhiteSpace(_form.ColumnaWatermarkTipo))
        {
            _error = "Elegiste una columna watermark: falta elegir su tipo (necesario para comparar bien un archivo).";
            return;
        }

        _guardando = true;
        try
        {
            // Fecha: 01/11/2026 - TAREA: 00155 - Linea: 1 - Antes decia "revisa la API o el nombre
            // duplicado", que son dos causas posibles entre muchas y ninguna confirmada. Ahora se
            // muestra lo que dijo la API, con el traceId para buscarlo en el log del servidor.
            var res = await Pipelines.GuardarAsync(ConstruirDef());
            if (res.Ok) Nav.NavigateTo("/pipelines");
            else _error = $"No se pudo guardar. {res.Mostrar()}";
        }
        finally { _guardando = false; }
    }

    private PipelineDefinition ConstruirDef()
    {
        // Fecha: 03/09/2026 - TAREA: 00015 - Linea: 1 - Origenes de archivo (Csv/Xlsx): sin sql, y con
        // columnaWatermark/tipoColumnaWatermark en la config del paso cuando hay watermark elegido. El
        // SourceFactory (Csv/Xlsx) lee esas dos claves via LeerStringOpcional para que FileSourceBase
        // pueda filtrar/tipar filas; sin esto el filtro quedaba como no-op aunque la UI dejara elegirlo.
        // Fecha: 31/10/2026 - TAREA: 00154 - Linea: 4 - El switch tenia "_ => SqlServerSource", asi que
        // un origen DataHub se guardaba como SqlServerSource. No fallaba al guardar: fallaba al correr,
        // con un error de conexion que no tenia nada que ver con la causa. Ahora cada tipo se nombra.
        // Revision 1: el "_ => SqlServerSource" seguia sin ser exhaustivo — un tipo futuro volveria a
        // caer en SQL Server en silencio, que es exactamente el bug que esta tarea vino a arreglar.
        var conector = TipoDataSourceElegido switch
        {
            0 or null => "SqlServerSource",
            1 => "CsvSource",
            2 => "XlsxSource",
            3 => "DataHubSource",
            var otro => throw new NotSupportedException(
                $"Tipo de origen {otro} sin conector asignado en el editor.")
        };
        var cfgOrigen = new Dictionary<string, JsonElement>
        {
            ["dataSourceId"] = JsonSerializer.SerializeToElement(_form.DataSourceId?.ToString() ?? "")
        };
        if (conector == "SqlServerSource")
        {
            cfgOrigen["sql"] = JsonSerializer.SerializeToElement(_form.Sql);
        }
        else if (conector == "DataHubSource")
        {
            // Fecha: 31/10/2026 - TAREA: 00154 - Linea: 4 - Revision 1, hallazgo P1: antes el metodo
            // salia de EndpointElegido con "GET" por defecto y el esquema se escribia solo si habia
            // endpoint cargado. Abrir un pipeline POST, cambiarle el nombre y guardar lo pasaba a GET
            // y le borraba el esquema. Ahora el catalogo solo pisa lo guardado cuando de verdad hay
            // un endpoint elegido; si no, se conserva lo que ya tenia el paso.
            var ep = EndpointElegido;
            cfgOrigen["ruta"] = JsonSerializer.SerializeToElement(_form.Ruta);

            var metodo = ep?.MetodoHttp
                         ?? (string.IsNullOrWhiteSpace(_form.MetodoHttp) ? "GET" : _form.MetodoHttp);
            cfgOrigen["metodoHttp"] = JsonSerializer.SerializeToElement(metodo);

            // Los parametros DECLARADOS por el endpoint, con su valor cargado (regla R1).
            cfgOrigen["parametros"] = JsonSerializer.SerializeToElement(ValoresDeParametros());

            var esquema = !string.IsNullOrWhiteSpace(ep?.EsquemaJson) ? ep!.EsquemaJson : _form.EsquemaJson;
            if (!string.IsNullOrWhiteSpace(esquema))
                cfgOrigen["esquema"] = JsonSerializer.SerializeToElement(esquema!);

            if (!string.IsNullOrWhiteSpace(_form.ColumnaWatermark))
                cfgOrigen["columnaWatermark"] = JsonSerializer.SerializeToElement(_form.ColumnaWatermark.Trim());
        }
        else if (!string.IsNullOrWhiteSpace(_form.ColumnaWatermark))
        {
            cfgOrigen["columnaWatermark"] = JsonSerializer.SerializeToElement(_form.ColumnaWatermark.Trim());
            if (!string.IsNullOrWhiteSpace(_form.ColumnaWatermarkTipo))
                cfgOrigen["tipoColumnaWatermark"] = JsonSerializer.SerializeToElement(_form.ColumnaWatermarkTipo.Trim());
        }

        var pasos = new List<StepDefinition>
        {
            new()
            {
                Nombre = "origen",
                Tipo = TipoPaso.Origen,
                Conector = conector,
                Configuracion = cfgOrigen
            }
        };

        foreach (var t in _form.Transforms)
        {
            var cfg = new Dictionary<string, JsonElement>();
            var rename = AMapa(t.Rename);
            var cast = AMapa(t.Cast);
            var computed = AMapa(t.Computed);
            if (rename.Count > 0) cfg["rename"] = JsonSerializer.SerializeToElement(rename);
            if (cast.Count > 0) cfg["cast"] = JsonSerializer.SerializeToElement(cast);
            if (computed.Count > 0) cfg["computed"] = JsonSerializer.SerializeToElement(computed);
            if (!string.IsNullOrWhiteSpace(t.Filter)) cfg["filter"] = JsonSerializer.SerializeToElement(t.Filter);

            pasos.Add(new StepDefinition
            {
                Nombre = string.IsNullOrWhiteSpace(t.Nombre) ? "transform" : t.Nombre.Trim(),
                Tipo = TipoPaso.Transformacion,
                Conector = "ColumnMapTransform",
                Configuracion = cfg
            });
        }

        return new PipelineDefinition
        {
            Id = _form.Id,
            Nombre = _form.Nombre.Trim(),
            Habilitado = _form.Habilitado,
            Programacion = (TipoProgramacion)_form.Programacion,
            HoraDelDia = _form.Programacion == 0 ? null : _form.HoraDelDia,
            DiaDeLaSemana = _form.Programacion == 2 ? _form.DiaDeLaSemana : null,
            DiaDelMes = _form.Programacion == 3 ? _form.DiaDelMes : null,
            TablaDestino = _form.TablaDestino.Trim(),
            ModoEscritura = (ModoEscritura)_form.ModoEscritura,
            FilasPorLote = _form.FilasPorLote,
            ColumnasClave = _form.ColumnasClave.Select(c => c.Trim()).Where(c => c.Length > 0).ToList(),
            EsquemaOrigen = _form.EsquemaOrigen
                .Select(c => new ColumnaOrigen { Nombre = c.Nombre, Tipo = c.Tipo })
                .ToList(),
            ColumnaWatermark = string.IsNullOrWhiteSpace(_form.ColumnaWatermark)
                ? null
                : _form.ColumnaWatermark!.Trim(),
            // Fecha: 03/09/2026 - TAREA: 00015 - Linea: 1
            ColumnaWatermarkTipo = string.IsNullOrWhiteSpace(_form.ColumnaWatermarkTipo)
                ? null
                : _form.ColumnaWatermarkTipo!.Trim(),
            Pasos = pasos
        };
    }

    private static Dictionary<string, string> AMapa(List<KV> items)
    {
        var d = new Dictionary<string, string>();
        foreach (var k in items)
            if (!string.IsNullOrWhiteSpace(k.Clave)) d[k.Clave.Trim()] = k.Valor;
        return d;
    }

    private void Cargar(PipelineDefinition def)
    {
        _form.Id = def.Id;
        _form.Nombre = def.Nombre;
        _form.Habilitado = def.Habilitado;
        _form.Programacion = (int)def.Programacion;
        _form.HoraDelDia = def.HoraDelDia ?? "08:00";
        _form.DiaDeLaSemana = def.DiaDeLaSemana ?? 1;
        _form.DiaDelMes = def.DiaDelMes ?? 1;
        _form.TablaDestino = def.TablaDestino;
        _form.ModoEscritura = (int)def.ModoEscritura;
        _form.ColumnasClave = def.ColumnasClave.ToList();
        _form.EsquemaOrigen = def.EsquemaOrigen
            .Select(c => new ColumnaOrigenDto(c.Nombre, c.Tipo))
            .ToList();
        _form.ColumnaWatermark = def.ColumnaWatermark ?? "";
        // Fecha: 03/09/2026 - TAREA: 00015 - Linea: 1
        _form.ColumnaWatermarkTipo = def.ColumnaWatermarkTipo ?? "";
        _form.FilasPorLote = def.FilasPorLote;

        var origen = def.Pasos.FirstOrDefault(p => p.Tipo == TipoPaso.Origen);
        if (origen is not null)
        {
            if (origen.Configuracion.TryGetValue("dataSourceId", out var dsEl)
                && dsEl.ValueKind == JsonValueKind.String && Guid.TryParse(dsEl.GetString(), out var g))
                _form.DataSourceId = g;
            if (origen.Configuracion.TryGetValue("sql", out var sqlEl) && sqlEl.ValueKind == JsonValueKind.String)
                _form.Sql = sqlEl.GetString() ?? "";

            // Fecha: 31/10/2026 - TAREA: 00154 - Linea: 4 - Origen DataHub: ruta, metodo, esquema y
            // parametros guardados. Los cuatro, porque los cuatro se vuelven a escribir al guardar.
            if (origen.Configuracion.TryGetValue("ruta", out var rutaEl) && rutaEl.ValueKind == JsonValueKind.String)
                _form.Ruta = rutaEl.GetString() ?? "";
            if (origen.Configuracion.TryGetValue("metodoHttp", out var mtEl) && mtEl.ValueKind == JsonValueKind.String)
                _form.MetodoHttp = mtEl.GetString() ?? "";
            if (origen.Configuracion.TryGetValue("esquema", out var esqEl) && esqEl.ValueKind == JsonValueKind.String)
                _form.EsquemaJson = esqEl.GetString();
            if (origen.Configuracion.TryGetValue("parametros", out var parEl) && parEl.ValueKind == JsonValueKind.Object)
                _form.Parametros = parEl.EnumerateObject()
                    .Select(x => new KV
                    {
                        Clave = x.Name,
                        Valor = x.Value.ValueKind == JsonValueKind.String ? x.Value.GetString() ?? "" : x.Value.ToString()
                    })
                    .ToList();
        }

        _form.Transforms = def.Pasos
            .Where(p => p.Tipo == TipoPaso.Transformacion)
            .Select(p => new TransformForm
            {
                Nombre = p.Nombre,
                Rename = LeerMapa(p, "rename"),
                Cast = LeerMapa(p, "cast"),
                Computed = LeerMapa(p, "computed"),
                Filter = LeerString(p, "filter")
            })
            .ToList();
    }

    private static List<KV> LeerMapa(StepDefinition s, string clave)
    {
        var l = new List<KV>();
        if (s.Configuracion.TryGetValue(clave, out var v) && v.ValueKind == JsonValueKind.Object)
            foreach (var p in v.EnumerateObject())
                l.Add(new KV
                {
                    Clave = p.Name,
                    Valor = p.Value.ValueKind == JsonValueKind.String ? p.Value.GetString() ?? "" : p.Value.GetRawText()
                });
        return l;
    }

    private static string? LeerString(StepDefinition s, string clave) =>
        s.Configuracion.TryGetValue(clave, out var v) && v.ValueKind == JsonValueKind.String ? v.GetString() : null;
}
