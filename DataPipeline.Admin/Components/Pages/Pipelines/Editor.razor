@page "/pipelines/nuevo"
@page "/pipelines/editar/{Id:guid}"
@inject PipelinesAdminService Pipelines
@inject DataSourcesAdminService Origenes
@inject NavigationManager Nav

<PageTitle>@(Id is null ? "Nuevo pipeline" : "Editar pipeline") — Admin</PageTitle>

<div class="page-header">
    <div>
        <h1 class="page-title">@(Id is null ? "Nuevo pipeline" : "Editar pipeline")</h1>
    </div>
    <SfButton CssClass="e-flat" OnClick="@(() => Nav.NavigateTo("/pipelines"))">Volver a la lista</SfButton>
</div>

@if (_error is not null)
{
    <SfMessage Severity="MessageSeverity.Error" CssClass="mb-3">@_error</SfMessage>
}

@if (_cargando)
{
    <div style="position:relative;min-height:80px;"><SfSpinner Visible="true" /></div>
}
else
{
    <div class="panel mb-3">
        <div class="pa-4 d-flex gap-3 align-center flex-wrap">
            <div class="flex-grow-1">
                <SfTextBox Placeholder="Nombre *" FloatLabelType="FloatLabelType.Always" @bind-Value="_form.Nombre" />
            </div>
            <SfCheckBox @bind-Checked="_form.Habilitado" Label="Habilitado"></SfCheckBox>
        </div>
    </div>

    <div class="d-flex align-center gap-2 mb-4 flex-wrap">
        <SfButton CssClass="@(_pasoActivo == 1 ? "e-primary e-small" : "e-flat e-small")" Disabled="@(!PasoHabilitado(1))" OnClick="@(() => IrAPaso(1))">1. Origen y columnas</SfButton>
        <span class="texto-secundario">›</span>
        <SfButton CssClass="@(_pasoActivo == 2 ? "e-primary e-small" : "e-flat e-small")" Disabled="@(!PasoHabilitado(2))" OnClick="@(() => IrAPaso(2))">2. Salida</SfButton>
        <span class="texto-secundario">›</span>
        <SfButton CssClass="@(_pasoActivo == 3 ? "e-primary e-small" : "e-flat e-small")" Disabled="@(!PasoHabilitado(3))" OnClick="@(() => IrAPaso(3))">3. Transformaciones</SfButton>
    </div>

    @if (_pasoActivo == 1)
    {
        <div class="panel mb-4">
            <div class="panel-header">Paso 1 — Origen y columnas</div>
            <div class="pa-4">
                <div class="mb-3">
                    <SfDropDownList TValue="Guid?" TItem="DataSourceVista" DataSource="_datasources" @bind-Value="_form.DataSourceId"
                                    Placeholder="DataSource *" FloatLabelType="FloatLabelType.Always">
                        <DropDownListFieldSettings Value="Id" Text="Nombre"></DropDownListFieldSettings>
                    </SfDropDownList>
                </div>
                <div class="mb-1">
                    <SfTextBox Placeholder="SQL *" FloatLabelType="FloatLabelType.Always" Multiline="true" @bind-Value="_form.Sql" />
                </div>
                <div class="mt-2 mb-3 d-flex align-center gap-2">
                    <SfButton CssClass="e-small" OnClick="TraerColumnas" Disabled="@(_form.DataSourceId is null || string.IsNullOrWhiteSpace(_form.Sql))">
                        Traer columnas
                    </SfButton>
                    @if (_columnasMsg is not null)
                    {
                        <span class="texto-caption texto-secundario">@_columnasMsg</span>
                    }
                </div>
                @if (_form.EsquemaOrigen.Count > 0)
                {
                    <div class="d-flex flex-wrap gap-2 mb-3">
                        @foreach (var c in _form.EsquemaOrigen)
                        {
                            <span style="border:1px solid #d0d0d0;border-radius:6px;padding:2px 8px;font-size:12px;">@c.Nombre <span class="texto-secundario">@c.Tipo</span></span>
                        }
                    </div>
                    <div class="mb-1">
                        <SfDropDownList TValue="string" TItem="string" DataSource="NombresColumnas" @bind-Value="_form.ColumnaWatermark"
                                        Placeholder="Columna watermark (opcional)" FloatLabelType="FloatLabelType.Always" AllowFiltering="true" />
                        <div class="texto-caption texto-secundario mt-1">
                            Tu SQL debe filtrar con @@watermark (ej. WHERE @@watermark IS NULL OR fecha_mod &gt; @@watermark).
                            Si la columna es fecha, debe ser datetime/datetime2.
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    @if (_pasoActivo == 2)
    {
        <div class="panel mb-4">
            <div class="panel-header">Paso 2 — Salida</div>
            <div class="pa-4">
                @if (_form.EsquemaOrigen.Count > 0)
                {
                    <div class="texto-caption texto-secundario mb-1">Columnas del origen</div>
                    <div class="d-flex flex-wrap gap-2 mb-3">
                        @foreach (var n in NombresColumnas)
                        {
                            <span style="border:1px solid #d0d0d0;border-radius:6px;padding:2px 8px;font-size:12px;">@n</span>
                        }
                    </div>
                }
                <div class="mb-3">
                    <SfMultiSelect TValue="List<string>" TItem="string" DataSource="NombresColumnas" @bind-Value="_form.ColumnasClave"
                                   Placeholder="Columnas clave (requerido si Reemplazar)" FloatLabelType="FloatLabelType.Always" AllowCustomValue="true" />
                </div>
                <div class="d-flex gap-3">
                    <div class="flex-grow-1 mb-3">
                        <SfDropDownList TValue="int" TItem="Opcion" DataSource="_modos" @bind-Value="_form.ModoEscritura"
                                        Placeholder="Modo de escritura" FloatLabelType="FloatLabelType.Always">
                            <DropDownListFieldSettings Value="Valor" Text="Texto"></DropDownListFieldSettings>
                        </SfDropDownList>
                    </div>
                    <div class="flex-grow-1 mb-3">
                        <SfTextBox Placeholder="Tabla destino *" FloatLabelType="FloatLabelType.Always" @bind-Value="_form.TablaDestino" />
                    </div>
                </div>
                <div class="mb-1" style="max-width:220px;">
                    <label class="texto-caption texto-secundario">Filas por lote</label>
                    <SfNumericTextBox TValue="int" @bind-Value="_form.FilasPorLote" Min="1"></SfNumericTextBox>
                </div>
            </div>
        </div>
    }

    @if (_pasoActivo == 3)
    {
        <div class="panel mb-4">
            <div class="panel-header d-flex justify-space-between align-center">
                <span>Paso 3 — Transformaciones (opcional)</span>
                <SfButton CssClass="e-small" OnClick="AgregarTransform">+ Agregar transformacion</SfButton>
            </div>
            <div class="pa-4">
                @if (_form.Transforms.Count == 0)
                {
                    <div class="texto-secundario">Sin transformaciones. El origen se escribe tal cual en la tabla destino.</div>
                }
                @for (var i = 0; i < _form.Transforms.Count; i++)
                {
                    var t = _form.Transforms[i];
                    var idx = i;
                    <div class="panel pa-3 mb-3">
                        <div class="d-flex justify-space-between align-center mb-1">
                            <strong>Bloque de transformacion @(idx + 1)</strong>
                            <span class="d-flex gap-1">
                                <SfButton CssClass="e-small" Disabled="@(idx == 0)" OnClick="@(() => Subir(t))">▲</SfButton>
                                <SfButton CssClass="e-small" Disabled="@(idx == _form.Transforms.Count - 1)" OnClick="@(() => Bajar(t))">▼</SfButton>
                                <SfButton CssClass="e-small e-danger e-outline" OnClick="@(() => QuitarTransform(t))">Quitar</SfButton>
                            </span>
                        </div>
                        <div class="texto-caption texto-secundario mb-3">Orden: renombrar → convertir tipo → calcular → filtrar</div>
                        <div class="mb-3">
                            <SfTextBox Placeholder="Nombre del bloque" FloatLabelType="FloatLabelType.Always" @bind-Value="t.Nombre" />
                        </div>
                        <KeyValueEditor Items="t.Rename" Titulo="Renombrar columnas" Descripcion="Cambia el nombre de una columna."
                                        ClaveLabel="Columna" ValorLabel="Nuevo nombre" ClaveOpciones="NombresColumnas" />
                        <KeyValueEditor Items="t.Cast" Titulo="Convertir tipo" Descripcion="Convierte el valor de una columna al tipo elegido."
                                        ClaveLabel="Columna" ValorLabel="Tipo" ClaveOpciones="NombresColumnas" ValorOpciones="_tiposCast" />
                        <KeyValueEditor Items="t.Computed" Titulo="Columna calculada" Descripcion="Crea una columna nueva con una expresion (ej. precio * 1.21)."
                                        ClaveLabel="Nueva columna" ValorLabel="Expresion" />
                        <div class="mb-2">
                            <label class="texto-body2" style="font-weight:600;">Filtrar filas</label>
                            <div class="texto-caption texto-secundario mb-1">Solo pasan las filas donde la expresion es verdadera (ej. monto &gt; 0).</div>
                            <SfTextBox Placeholder="Expresion booleana (opcional)" @bind-Value="t.Filter" />
                        </div>
                        <div class="pa-2 mb-1" style="border:0.5px solid #d0d0d0;border-radius:6px;">
                            <div class="texto-caption texto-secundario">
                                <strong>Sintaxis (NCalc):</strong>
                                operadores <code>+ - * / &gt; &lt; == != and or not</code> ·
                                condicional <code>if(cond, a, b)</code> ·
                                funciones <code>Round, Abs, Max, Min, Floor, Ceiling</code>.
                                <a href="https://github.com/ncalc/ncalc/wiki/Functions" target="_blank" rel="noopener">Ver funciones</a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="panel mb-4">
            <div class="panel-header">Programacion</div>
            <div class="pa-4">
                <div class="d-flex gap-3 flex-wrap">
                    <div class="flex-grow-1 mb-3">
                        <SfDropDownList TValue="int" TItem="Opcion" DataSource="_programaciones" @bind-Value="_form.Programacion"
                                        Placeholder="Programacion" FloatLabelType="FloatLabelType.Always">
                            <DropDownListFieldSettings Value="Valor" Text="Texto"></DropDownListFieldSettings>
                        </SfDropDownList>
                    </div>
                    @if (_form.Programacion != 0)
                    {
                        <div class="flex-grow-1 mb-3">
                            <SfTextBox Placeholder="Hora del dia (HH:mm)" FloatLabelType="FloatLabelType.Always" @bind-Value="_form.HoraDelDia" />
                        </div>
                    }
                    @if (_form.Programacion == 2)
                    {
                        <div class="flex-grow-1 mb-3">
                            <SfDropDownList TValue="int" TItem="Opcion" DataSource="_diasSemana" @bind-Value="_form.DiaDeLaSemana"
                                            Placeholder="Dia de la semana" FloatLabelType="FloatLabelType.Always">
                                <DropDownListFieldSettings Value="Valor" Text="Texto"></DropDownListFieldSettings>
                            </SfDropDownList>
                        </div>
                    }
                    @if (_form.Programacion == 3)
                    {
                        <div class="flex-grow-1 mb-3">
                            <label class="texto-caption texto-secundario">Dia del mes (1-28)</label>
                            <SfNumericTextBox TValue="int" @bind-Value="_form.DiaDelMes" Min="1" Max="28"></SfNumericTextBox>
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    <div class="d-flex gap-2 mb-8 align-center">
        <SfButton CssClass="e-flat" OnClick="Atras" Disabled="@(_pasoActivo == 1)">← Atras</SfButton>
        @if (_pasoActivo < 3)
        {
            <SfButton CssClass="e-primary" OnClick="Siguiente" Disabled="@(!PuedeAvanzar)">Siguiente →</SfButton>
            @if (_pasoActivo == 1 && !PuedeAvanzar)
            {
                <span class="texto-caption texto-secundario">Trae las columnas para continuar.</span>
            }
        }
        else
        {
            <SfButton CssClass="e-primary" OnClick="Guardar" Disabled="_guardando">
                @(_guardando ? "Guardando..." : "Guardar")
            </SfButton>
        }
        <SfButton CssClass="e-flat" OnClick="@(() => Nav.NavigateTo("/pipelines"))">Cancelar</SfButton>
    </div>
}

@code {
    [Parameter] public Guid? Id { get; set; }

    private sealed record Opcion(int Valor, string Texto);

    private sealed class PipelineForm
    {
        public Guid Id { get; set; }
        public string Nombre { get; set; } = "";
        public bool Habilitado { get; set; } = true;
        public string TablaDestino { get; set; } = "";
        public int ModoEscritura { get; set; } = 2; // Reemplazar
        public List<string> ColumnasClave { get; set; } = new();
        public string? ColumnaWatermark { get; set; } = ""; // columna del origen a trackear; vacio = no incremental
        public List<ColumnaOrigenDto> EsquemaOrigen { get; set; } = new();
        public int Programacion { get; set; }        // 0 = BajoDemanda
        public string? HoraDelDia { get; set; } = "08:00";
        public int DiaDeLaSemana { get; set; } = 1;
        public int DiaDelMes { get; set; } = 1;
        public int FilasPorLote { get; set; } = 5000;
        public Guid? DataSourceId { get; set; }
        public string Sql { get; set; } = "";
        public List<TransformForm> Transforms { get; set; } = new();
    }

    private sealed class TransformForm
    {
        public string Nombre { get; set; } = "transform";
        public List<KV> Rename { get; set; } = new();
        public List<KV> Cast { get; set; } = new();
        public List<KV> Computed { get; set; } = new();
        public string? Filter { get; set; }
    }

    private readonly List<Opcion> _modos = new() { new(0, "Agregar"), new(2, "Reemplazar") };
    private readonly List<Opcion> _programaciones = new()
    {
        new(0, "Bajo demanda"), new(1, "Diaria"), new(2, "Semanal"), new(3, "Mensual")
    };
    private readonly List<Opcion> _diasSemana = new()
    {
        new(0, "Domingo"), new(1, "Lunes"), new(2, "Martes"), new(3, "Miercoles"),
        new(4, "Jueves"), new(5, "Viernes"), new(6, "Sabado")
    };
    private readonly List<string> _tiposCast = new() { "int", "long", "decimal", "double", "bool", "date", "string" };

    private List<DataSourceVista> _datasources = new();
    private PipelineForm _form = new();
    private bool _cargando = true;
    private bool _guardando;
    private string? _error;
    private string? _columnasMsg;

    private int _pasoActivo = 1;

    private bool Editando => Id is not null;

    // Gates: P1 requiere columnas traidas; P2 requiere destino + (si Reemplazar) al menos una clave.
    private bool GateP1 => _form.EsquemaOrigen.Count > 0;
    private bool GateP2 => !string.IsNullOrWhiteSpace(_form.TablaDestino)
        && (_form.ModoEscritura != 2 || _form.ColumnasClave.Count > 0);

    // En modo edicion todos los pasos son navegables (el pipeline ya es valido).
    private bool PasoHabilitado(int n) => Editando || n switch
    {
        1 => true,
        2 => GateP1,
        3 => GateP1 && GateP2,
        _ => false
    };

    private bool PuedeAvanzar => Editando || _pasoActivo switch { 1 => GateP1, 2 => GateP2, _ => true };

    private void IrAPaso(int n) { if (PasoHabilitado(n)) _pasoActivo = n; }
    private void Atras() { if (_pasoActivo > 1) _pasoActivo--; }
    private void Siguiente() { if (_pasoActivo < 3 && PuedeAvanzar) _pasoActivo++; }

    protected override async Task OnInitializedAsync()
    {
        _datasources = await Origenes.ObtenerTodosAsync();

        if (Id is Guid id)
        {
            var def = await Pipelines.ObtenerPorIdAsync(id);
            if (def is null) { _error = "No se encontro el pipeline."; }
            else { Cargar(def); }
        }
        _cargando = false;
    }

    private void AgregarTransform() =>
        _form.Transforms.Add(new TransformForm { Nombre = $"transform{_form.Transforms.Count + 1}" });

    private void QuitarTransform(TransformForm t) => _form.Transforms.Remove(t);

    private async Task TraerColumnas()
    {
        _columnasMsg = "Trayendo...";
        var cols = await Origenes.TraerColumnasAsync(_form.DataSourceId!.Value, _form.Sql);
        if (cols is null)
        {
            _columnasMsg = "No se pudieron traer las columnas (revisa el SQL o la conexion).";
            return;
        }
        _form.EsquemaOrigen = cols;
        _columnasMsg = $"{cols.Count} columnas.";
    }

    private List<string> NombresColumnas => _form.EsquemaOrigen.Select(c => c.Nombre).ToList();

    private void Subir(TransformForm t)
    {
        var i = _form.Transforms.IndexOf(t);
        if (i > 0) { _form.Transforms.RemoveAt(i); _form.Transforms.Insert(i - 1, t); }
    }

    private void Bajar(TransformForm t)
    {
        var i = _form.Transforms.IndexOf(t);
        if (i >= 0 && i < _form.Transforms.Count - 1) { _form.Transforms.RemoveAt(i); _form.Transforms.Insert(i + 1, t); }
    }

    private async Task Guardar()
    {
        _error = null;
        if (string.IsNullOrWhiteSpace(_form.Nombre)) { _error = "El nombre es obligatorio."; return; }
        if (string.IsNullOrWhiteSpace(_form.TablaDestino)) { _error = "La tabla destino es obligatoria."; return; }
        if (_form.DataSourceId is null || string.IsNullOrWhiteSpace(_form.Sql))
        {
            _error = "El origen requiere un DataSource y un SQL.";
            return;
        }
        if (_form.ModoEscritura == 2 && _form.ColumnasClave.Count == 0)
        {
            _error = "Reemplazar requiere al menos una columna clave.";
            return;
        }

        _guardando = true;
        try
        {
            var ok = await Pipelines.GuardarAsync(ConstruirDef());
            if (ok) Nav.NavigateTo("/pipelines");
            else _error = "No se pudo guardar (revisa la API o el nombre duplicado).";
        }
        finally { _guardando = false; }
    }

    private PipelineDefinition ConstruirDef()
    {
        var pasos = new List<StepDefinition>
        {
            new()
            {
                Nombre = "origen",
                Tipo = TipoPaso.Origen,
                Conector = "SqlServerSource",
                Configuracion = new()
                {
                    ["dataSourceId"] = JsonSerializer.SerializeToElement(_form.DataSourceId?.ToString() ?? ""),
                    ["sql"] = JsonSerializer.SerializeToElement(_form.Sql)
                }
            }
        };

        foreach (var t in _form.Transforms)
        {
            var cfg = new Dictionary<string, JsonElement>();
            var rename = AMapa(t.Rename);
            var cast = AMapa(t.Cast);
            var computed = AMapa(t.Computed);
            if (rename.Count > 0) cfg["rename"] = JsonSerializer.SerializeToElement(rename);
            if (cast.Count > 0) cfg["cast"] = JsonSerializer.SerializeToElement(cast);
            if (computed.Count > 0) cfg["computed"] = JsonSerializer.SerializeToElement(computed);
            if (!string.IsNullOrWhiteSpace(t.Filter)) cfg["filter"] = JsonSerializer.SerializeToElement(t.Filter);

            pasos.Add(new StepDefinition
            {
                Nombre = string.IsNullOrWhiteSpace(t.Nombre) ? "transform" : t.Nombre.Trim(),
                Tipo = TipoPaso.Transformacion,
                Conector = "ColumnMapTransform",
                Configuracion = cfg
            });
        }

        return new PipelineDefinition
        {
            Id = _form.Id,
            Nombre = _form.Nombre.Trim(),
            Habilitado = _form.Habilitado,
            Programacion = (TipoProgramacion)_form.Programacion,
            HoraDelDia = _form.Programacion == 0 ? null : _form.HoraDelDia,
            DiaDeLaSemana = _form.Programacion == 2 ? _form.DiaDeLaSemana : null,
            DiaDelMes = _form.Programacion == 3 ? _form.DiaDelMes : null,
            TablaDestino = _form.TablaDestino.Trim(),
            ModoEscritura = (ModoEscritura)_form.ModoEscritura,
            FilasPorLote = _form.FilasPorLote,
            ColumnasClave = _form.ColumnasClave.Select(c => c.Trim()).Where(c => c.Length > 0).ToList(),
            EsquemaOrigen = _form.EsquemaOrigen
                .Select(c => new ColumnaOrigen { Nombre = c.Nombre, Tipo = c.Tipo })
                .ToList(),
            ColumnaWatermark = string.IsNullOrWhiteSpace(_form.ColumnaWatermark)
                ? null
                : _form.ColumnaWatermark!.Trim(),
            Pasos = pasos
        };
    }

    private static Dictionary<string, string> AMapa(List<KV> items)
    {
        var d = new Dictionary<string, string>();
        foreach (var k in items)
            if (!string.IsNullOrWhiteSpace(k.Clave)) d[k.Clave.Trim()] = k.Valor;
        return d;
    }

    private void Cargar(PipelineDefinition def)
    {
        _form.Id = def.Id;
        _form.Nombre = def.Nombre;
        _form.Habilitado = def.Habilitado;
        _form.Programacion = (int)def.Programacion;
        _form.HoraDelDia = def.HoraDelDia ?? "08:00";
        _form.DiaDeLaSemana = def.DiaDeLaSemana ?? 1;
        _form.DiaDelMes = def.DiaDelMes ?? 1;
        _form.TablaDestino = def.TablaDestino;
        _form.ModoEscritura = (int)def.ModoEscritura;
        _form.ColumnasClave = def.ColumnasClave.ToList();
        _form.EsquemaOrigen = def.EsquemaOrigen
            .Select(c => new ColumnaOrigenDto(c.Nombre, c.Tipo))
            .ToList();
        _form.ColumnaWatermark = def.ColumnaWatermark ?? "";
        _form.FilasPorLote = def.FilasPorLote;

        var origen = def.Pasos.FirstOrDefault(p => p.Tipo == TipoPaso.Origen);
        if (origen is not null)
        {
            if (origen.Configuracion.TryGetValue("dataSourceId", out var dsEl)
                && dsEl.ValueKind == JsonValueKind.String && Guid.TryParse(dsEl.GetString(), out var g))
                _form.DataSourceId = g;
            if (origen.Configuracion.TryGetValue("sql", out var sqlEl) && sqlEl.ValueKind == JsonValueKind.String)
                _form.Sql = sqlEl.GetString() ?? "";
        }

        _form.Transforms = def.Pasos
            .Where(p => p.Tipo == TipoPaso.Transformacion)
            .Select(p => new TransformForm
            {
                Nombre = p.Nombre,
                Rename = LeerMapa(p, "rename"),
                Cast = LeerMapa(p, "cast"),
                Computed = LeerMapa(p, "computed"),
                Filter = LeerString(p, "filter")
            })
            .ToList();
    }

    private static List<KV> LeerMapa(StepDefinition s, string clave)
    {
        var l = new List<KV>();
        if (s.Configuracion.TryGetValue(clave, out var v) && v.ValueKind == JsonValueKind.Object)
            foreach (var p in v.EnumerateObject())
                l.Add(new KV
                {
                    Clave = p.Name,
                    Valor = p.Value.ValueKind == JsonValueKind.String ? p.Value.GetString() ?? "" : p.Value.GetRawText()
                });
        return l;
    }

    private static string? LeerString(StepDefinition s, string clave) =>
        s.Configuracion.TryGetValue(clave, out var v) && v.ValueKind == JsonValueKind.String ? v.GetString() : null;
}
