@page "/pipelines"
@inject PipelinesAdminService Pipelines
@inject NavigationManager Nav

<PageTitle>Pipelines — Admin</PageTitle>

<div class="page-header">
    <div>
        <h1 class="page-title">Pipelines</h1>
        <p class="page-subtitle">Definicion de pipelines, edicion y corrida on-demand.</p>
    </div>
    @* Fecha: 02/11/2026 - TAREA: 00157 - Linea: 4 - Ruta relativa a la base: con PathBase (/datapipeline) una ruta con «/» inicial saldria del prefijo de AppHub. *@
    <SfButton CssClass="e-primary" OnClick="@(() => Nav.NavigateTo("pipelines/nuevo"))">
        <span class="e-icons e-plus" style="margin-right:.4rem;font-size:.75rem;"></span>Nuevo pipeline
    </SfButton>
</div>

@if (_mensaje is not null)
{
    <SfMessage Severity="@(_mensajeOk ? MessageSeverity.Success : MessageSeverity.Error)" CssClass="mb-3">@_mensaje</SfMessage>
}

<SfGrid DataSource="_items" AllowPaging="true" AllowSorting="true">
    <GridPageSettings PageSize="15"></GridPageSettings>
    <GridColumns>
        <GridColumn Field="@nameof(PipelineDefinition.Nombre)" HeaderText="Nombre"></GridColumn>
        <GridColumn HeaderText="Habilitado" Width="120" TextAlign="TextAlign.Center">
            <Template Context="ctx">
                @{ var p = (PipelineDefinition)ctx; }
                <span class="e-badge @(p.Habilitado ? "e-badge-success" : "e-badge-danger")">@(p.Habilitado ? "Si" : "No")</span>
            </Template>
        </GridColumn>
        <GridColumn Field="@nameof(PipelineDefinition.Programacion)" HeaderText="Programacion" Width="140"></GridColumn>
        <GridColumn Field="@nameof(PipelineDefinition.ProximaCorrida)" HeaderText="Proxima" Type="ColumnType.DateTime" Format="g" Width="170"></GridColumn>
        <GridColumn Field="@nameof(PipelineDefinition.UltimaCorrida)" HeaderText="Ultima" Type="ColumnType.DateTime" Format="g" Width="170"></GridColumn>
        <GridColumn Field="@nameof(PipelineDefinition.TablaDestino)" HeaderText="Tabla destino"></GridColumn>
        <GridColumn HeaderText="Acciones" Width="220">
            <Template Context="ctx">
                @{ var p = (PipelineDefinition)ctx; }
                @* Fecha: 02/11/2026 - TAREA: 00157 - Linea: 4 - Ruta relativa a la base: con PathBase (/datapipeline) una ruta con «/» inicial saldria del prefijo de AppHub. *@
                <SfButton CssClass="e-small" OnClick="@(() => Nav.NavigateTo($"pipelines/editar/{p.Id}"))">Editar</SfButton>
                <SfButton CssClass="e-small e-primary" Disabled="_corriendo" OnClick="@(() => Correr(p.Id))">Correr ahora</SfButton>
            </Template>
        </GridColumn>
    </GridColumns>
</SfGrid>

@code {
    private List<PipelineDefinition> _items = new();
    private bool _corriendo;
    private string? _mensaje;
    private bool _mensajeOk;

    protected override async Task OnInitializedAsync() => _items = await Pipelines.ObtenerTodosAsync();

    private async Task Correr(Guid id)
    {
        _corriendo = true;
        _mensaje = null;
        try
        {
            // Fecha: 01/11/2026 - TAREA: 00155 - Linea: 1 - Se distinguen dos cosas que antes se
            // mezclaban: que la corrida no haya podido ARRANCAR (la API no contesto, credenciales)
            // y que haya arrancado y FALLADO (ahi el error lo manda la corrida misma).
            var (corrida, res) = await Pipelines.CorrerAsync(id);
            if (!res.Ok)
            {
                _mensaje = $"No se pudo correr. {res.Mostrar()}";
                _mensajeOk = false;
            }
            else
            {
                _mensajeOk = corrida!.Success;
                _mensaje = corrida.Success
                    ? $"Corrida OK: leidas {corrida.RowsRead}, escritas {corrida.RowsWritten}."
                    : $"Corrida con error: {corrida.Error}";
            }
            _items = await Pipelines.ObtenerTodosAsync();
        }
        finally { _corriendo = false; }
    }
}
