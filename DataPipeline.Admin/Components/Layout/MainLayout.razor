@inherits LayoutComponentBase
@inject AdminSessionState Session
@inject NavigationManager Nav
@implements IDisposable

@if (Session.IsAuthenticated)
{
    <div class="page">
        <div class="sidebar">
            <NavMenu />
        </div>

        <main>
            <div class="top-row px-4 d-flex justify-space-between align-center">
                <span></span>
                <span class="d-flex align-center gap-3">
                    <span class="d-inline-flex align-center gap-2 texto-body2" style="color:#475569;">
                        <span style="width:28px;height:28px;border-radius:50%;background:rgba(99,102,241,.12);color:#6366f1;display:inline-flex;align-items:center;justify-content:center;">
                            <span class="e-icons e-user" style="font-size:.8rem;"></span>
                        </span>
                        @Session.Username
                    </span>
                    @* Fecha: 02/11/2026 - TAREA: 00157 - Linea: 3 - Con sesion de AppHub no hay «Salir»: se sale desde AppHub. *@
                    @if (Session.Origen == OrigenSesion.Local)
                    {
                        <SfButton CssClass="e-flat e-small" OnClick="CerrarSesion">Salir</SfButton>
                    }
                </span>
            </div>

            <article class="content px-4">
                @Body
            </article>
        </main>
    </div>
}

<div id="blazor-error-ui" data-nosnippet>
    Ocurrio un error inesperado.
    <a href="." class="reload">Recargar</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        Session.OnChange += OnSessionChange;

        // Fecha: 02/11/2026 - TAREA: 00157 - Linea: 2,3 - Antes del gate: si AppHub mando una identidad valida, la sesion se abre aca.
        await Session.InicializarAsync();

        // Gate central: cualquier pagina que use MainLayout exige sesion.
        if (!Session.IsAuthenticated)
        {
            // Fecha: 02/11/2026 - TAREA: 00157 - Linea: 4 - Ruta relativa a la base: con PathBase (/datapipeline) una ruta con «/» inicial saldria del prefijo de AppHub.
            Nav.NavigateTo("login");
        }
    }

    private void OnSessionChange() => InvokeAsync(StateHasChanged);

    private void CerrarSesion()
    {
        Session.CerrarSesion();
        // Fecha: 02/11/2026 - TAREA: 00157 - Linea: 4 - Ruta relativa a la base: con PathBase (/datapipeline) una ruta con «/» inicial saldria del prefijo de AppHub.
        Nav.NavigateTo("login");
    }

    public void Dispose() => Session.OnChange -= OnSessionChange;
}
