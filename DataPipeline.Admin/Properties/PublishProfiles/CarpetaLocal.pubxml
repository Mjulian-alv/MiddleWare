<?xml version="1.0" encoding="utf-8"?>
<!--
  Fecha: 02/11/2026 - TAREA: 00155 - Linea: 1 - Perfil de publicacion del panel.

  Publica a D:\Sistemas\MiddleWare-publish\admin. Desde Visual Studio (Compilar > Publicar) o:

      dotnet publish DataPipeline.Admin -c Release -p:PublishProfile=CarpetaLocal

  DeleteExistingFiles TIENE que quedar en false: en el destino vive admin-credentials.json,
  que guarda la contrasena del panel definida en el primer ingreso, y la carpeta logs\.
  Publicar con true obligaria a redefinir la contrasena en cada publicacion.

  OJO con appsettings.json: la publicacion lo PISA con el del proyecto, que apunta a
  https://localhost:7221 (la URL de desarrollo). Por eso 2-iniciar-admin.cmd fija
  ApiBaseUrl=http://localhost:5127 por variable de entorno, que le gana al archivo. Si se
  edita el appsettings.json del destino a mano, el cambio se pierde en la proxima publicacion.
-->
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <WebPublishMethod>FileSystem</WebPublishMethod>
    <PublishProvider>FileSystem</PublishProvider>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <LastUsedPlatform>Any CPU</LastUsedPlatform>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <TargetFramework>net10.0</TargetFramework>
    <!-- PublishUrl lo lee la interfaz de Visual Studio; PublishDir es la que respeta
         'dotnet publish' por consola. Si se cambia una, hay que cambiar la otra. -->
    <PublishUrl>D:\Sistemas\MiddleWare-publish\admin\</PublishUrl>
    <PublishDir>D:\Sistemas\MiddleWare-publish\admin\</PublishDir>
    <DeleteExistingFiles>false</DeleteExistingFiles>
    <ExcludeApp_Data>false</ExcludeApp_Data>
    <SelfContained>false</SelfContained>
    <!-- <RuntimeIdentifier>win-x64</RuntimeIdentifier> -->
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishSingleFile>false</PublishSingleFile>
    <_TargetId>Folder</_TargetId>
  </PropertyGroup>
</Project>
