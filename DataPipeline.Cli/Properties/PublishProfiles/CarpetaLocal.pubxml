<?xml version="1.0" encoding="utf-8"?>
<!--
  Fecha: 02/11/2026 - TAREA: 00155 - Linea: 1 - Perfil de publicacion del CLI.

  Publica a D:\Sistemas\MiddleWare-publish\cli. Desde Visual Studio (Compilar > Publicar) o:

      dotnet publish DataPipeline.Cli -c Release -p:PublishProfile=CarpetaLocal

  Es el unico de los tres que no tiene estado propio en el destino, pero DeleteExistingFiles
  queda igual en false para que los tres perfiles se comporten de la misma manera: que uno
  borre y los otros no es la clase de diferencia que sorprende justo cuando no hay que perder nada.
-->
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <WebPublishMethod>FileSystem</WebPublishMethod>
    <PublishProvider>FileSystem</PublishProvider>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <LastUsedPlatform>Any CPU</LastUsedPlatform>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <TargetFramework>net10.0</TargetFramework>
    <!-- PublishUrl lo lee la interfaz de Visual Studio; PublishDir es la que respeta
         'dotnet publish' por consola. Si se cambia una, hay que cambiar la otra. -->
    <PublishUrl>D:\Sistemas\MiddleWare-publish\cli\</PublishUrl>
    <PublishDir>D:\Sistemas\MiddleWare-publish\cli\</PublishDir>
    <DeleteExistingFiles>false</DeleteExistingFiles>
    <ExcludeApp_Data>false</ExcludeApp_Data>
    <SelfContained>false</SelfContained>
    <!-- <RuntimeIdentifier>win-x64</RuntimeIdentifier> -->
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishSingleFile>false</PublishSingleFile>
    <_TargetId>Folder</_TargetId>
  </PropertyGroup>
</Project>
