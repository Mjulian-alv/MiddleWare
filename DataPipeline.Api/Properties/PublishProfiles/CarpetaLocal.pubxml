<?xml version="1.0" encoding="utf-8"?>
<!--
  Fecha: 02/11/2026 - TAREA: 00155 - Linea: 1 - Perfil de publicacion de la API.

  Publica a D:\Sistemas\MiddleWare-publish\api, que es la carpeta que documenta el LEEME.md
  de esa publicacion. Se puede disparar desde Visual Studio (Compilar > Publicar) o por consola:

      dotnet publish DataPipeline.Api -c Release -p:PublishProfile=CarpetaLocal

  DeleteExistingFiles TIENE que quedar en false. Si se pone en true, cada publicacion borra
  metadata.db, data.db y la carpeta logs\ que viven en el destino, y se pierden los pipelines,
  los origenes y el historial de corridas que haya cargados para probar.

  Framework-dependent a proposito: la maquina de pruebas ya tiene el runtime .NET 10. Para un
  servidor sin .NET, poner SelfContained en true y descomentar el RuntimeIdentifier.
-->
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <WebPublishMethod>FileSystem</WebPublishMethod>
    <PublishProvider>FileSystem</PublishProvider>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <LastUsedPlatform>Any CPU</LastUsedPlatform>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <TargetFramework>net10.0</TargetFramework>
    <!-- PublishUrl lo lee la interfaz de Visual Studio; PublishDir es la que respeta
         'dotnet publish' por consola. Si se cambia una, hay que cambiar la otra. -->
    <PublishUrl>D:\Sistemas\MiddleWare-publish\api\</PublishUrl>
    <PublishDir>D:\Sistemas\MiddleWare-publish\api\</PublishDir>
    <DeleteExistingFiles>false</DeleteExistingFiles>
    <ExcludeApp_Data>false</ExcludeApp_Data>
    <SelfContained>false</SelfContained>
    <!-- <RuntimeIdentifier>win-x64</RuntimeIdentifier> -->
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishSingleFile>false</PublishSingleFile>
    <_TargetId>Folder</_TargetId>
  </PropertyGroup>
</Project>
